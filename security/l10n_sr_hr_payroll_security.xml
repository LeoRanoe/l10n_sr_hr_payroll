<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="group_sr_payroll_accountant_export" model="res.groups">
            <field name="name">SR Payroll Accountant Export</field>
            <field name="category_id" ref="base.module_category_human_resources_payroll"/>
            <field name="implied_ids" eval="[(4, ref('base.group_allow_export'))]"/>
        </record>

        <function model="ir.rule" name="write">
            <value model="ir.rule" search="[('id', '=', ref('hr_payroll.ir_rule_hr_payroll_structure_multi_company'))]"/>
            <value eval="{'domain_force': &quot;['|', '|', ('country_id', '=', False), ('country_id.code', '=', 'SR'), ('country_id', 'in', user.env.companies.mapped('country_id').ids)]&quot;}"/>
        </function>

        <function model="ir.rule" name="write">
            <value model="ir.rule" search="[('id', '=', ref('hr_payroll.ir_rule_hr_payroll_salary_rule_multi_company'))]"/>
            <value eval="{'domain_force': &quot;['|', '|', ('struct_id.country_id', '=', False), ('struct_id.country_id.code', '=', 'SR'), ('struct_id.country_id', 'in', user.env.companies.mapped('country_id').ids)]&quot;}"/>
        </function>

        <function model="ir.rule" name="write">
            <value model="ir.rule" search="[('id', '=', ref('hr_payroll.ir_rule_hr_payslip_input_type_multi_company'))]"/>
            <value eval="{'domain_force': &quot;['|', '|', ('country_id', '=', False), ('country_id.code', '=', 'SR'), ('country_id', 'in', user.env.companies.mapped('country_id').ids)]&quot;}"/>
        </function>

        <function model="ir.rule" name="write">
            <value model="ir.rule" search="[('id', '=', ref('hr_payroll.ir_rule_hr_payroll_paramater_multi_company'))]"/>
            <value eval="{'domain_force': &quot;['|', '|', ('country_id', '=', False), ('country_id.code', '=', 'SR'), ('country_id', 'in', user.env.companies.mapped('country_id').ids)]&quot;}"/>
        </function>

        <function model="ir.rule" name="write">
            <value model="ir.rule" search="[('id', '=', ref('hr_payroll.ir_rule_hr_payroll_paramater_value_multi_company'))]"/>
            <value eval="{'domain_force': &quot;['|', '|', ('country_id', '=', False), ('country_id.code', '=', 'SR'), ('country_id', 'in', user.env.companies.mapped('country_id').ids)]&quot;}"/>
        </function>

        <record id="rule_hr_payroll_tax_report_multi_company" model="ir.rule">
            <field name="name">SR Fiscaal Overzicht per toegelaten bedrijf</field>
            <field name="model_id" ref="l10n_sr_hr_payroll.model_hr_payroll_tax_report"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[
                (4, ref('hr_payroll.group_hr_payroll_user')),
                (4, ref('hr_payroll.group_hr_payroll_manager')),
                (4, ref('l10n_sr_hr_payroll.group_sr_payroll_accountant_export')),
                (4, ref('base.group_system'))
            ]"/>
        </record>

        <record id="rule_hr_contract_sr_line_multi_company" model="ir.rule">
            <field name="name">SR contractregels per toegelaten bedrijf</field>
            <field name="model_id" ref="l10n_sr_hr_payroll.model_hr_contract_sr_line"/>
            <field name="domain_force">['|', ('contract_id.company_id', '=', False), ('contract_id.company_id', 'in', company_ids)]</field>
            <field name="groups" eval="[
                (4, ref('hr_payroll.group_hr_payroll_user')),
                (4, ref('hr_payroll.group_hr_payroll_manager'))
            ]"/>
        </record>

    </data>
</odoo>
