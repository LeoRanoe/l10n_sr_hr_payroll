<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_report_sr_maandaangifte" model="ir.actions.report">
        <field name="name">Aangifte Loonbelasting &amp; AOV</field>
        <field name="model">hr.payslip.run</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_sr_hr_payroll.report_sr_maandaangifte</field>
        <field name="print_report_name">
            'Maandaangifte LB-AOV - %s' % (object.name or '')
        </field>
        <field name="paperformat_id" ref="l10n_sr_hr_payroll.paperformat_sr_landscape"/>
    </record>

    <template id="report_sr_maandaangifte">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="rd" t-value="o._sr_get_maandaangifte_data()"/>
                <t t-call="web.external_layout">
                    <div class="page">

                        <!-- ── Koptitel ─────────────────────────────────────── -->
                        <h2 style="margin-bottom:2px;">AANGIFTE LOONBELASTING EN PREMIE AOV</h2>
                        <p class="text-muted" style="font-size:9pt; margin-top:0; margin-bottom:12px;">
                            Wet Loonbelasting Suriname&#160;·&#160;Stichting Algemene Ouderdomsvoorziening
                        </p>

                        <!-- ── Inhoudingsplichtige + aangifteperiode ────────── -->
                        <table class="table table-sm table-borderless" id="aangifte_header_table">
                            <thead class="o_black_border">
                                <tr>
                                    <th>Gegevens Inhoudingsplichtige</th>
                                    <th>Aangifteperiode</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>
                                        <div>
                                            <strong class="me-2">Naam:</strong>
                                            <span t-esc="rd['company_name']"/>
                                        </div>
                                        <div>
                                            <strong class="me-2">FIN-nummer:</strong>
                                            <span t-if="rd['company_vat']" t-esc="rd['company_vat']"/>
                                            <span t-else="" style="color:#875A7B;" class="fw-bold">Niet ingevuld</span>
                                        </div>
                                        <div t-if="rd.get('company_address')">
                                            <strong class="me-2">Adres:</strong>
                                            <span t-esc="rd.get('company_address')"/>
                                        </div>
                                        <div t-if="rd.get('company_phone')">
                                            <strong class="me-2">Telefoon:</strong>
                                            <span t-esc="rd.get('company_phone')"/>
                                        </div>
                                    </td>
                                    <td>
                                        <div>
                                            <strong class="me-2">Loonrun:</strong>
                                            <span t-esc="rd['run_name']"/>
                                        </div>
                                        <div>
                                            <strong class="me-2">Tijdvak:</strong>
                                            <span t-esc="rd['period_label']"/>
                                            <small class="text-muted">
                                                &#160;(<t t-esc="str(rd['date_from'])"/> t/m <t t-esc="str(rd['date_to'])"/>)
                                            </small>
                                        </div>
                                        <div>
                                            <strong class="me-2">Uiterlijke betaaldatum:</strong>
                                            <span style="color:#875A7B;" class="fw-bold"
                                                  t-esc="rd['betaaldatum']"/>
                                        </div>
                                        <div>
                                            <strong class="me-2">Aangifte via:</strong>
                                            <em class="text-muted">portaal.belastingdienst.sr</em>
                                        </div>
                                        <div>
                                            <strong class="me-2">Gegenereerd op:</strong>
                                            <span t-esc="str(rd['generated_on'])"/>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- ── Werknemerstabel ──────────────────────────────── -->
                        <table class="table table-sm" id="aangifte_employees_table"
                               style="font-size:7.5pt;">
                            <thead class="o_black_border">
                                <tr>
                                    <th style="width:20%;">Naam werknemer</th>
                                    <th style="width:9%;">CRIB-nr.</th>
                                    <th class="text-end" style="width:9%;">Bruto loon</th>
                                    <th class="text-end" style="width:9%;">
                                        LB Art. 14<br/><small>regulier</small>
                                    </th>
                                    <th class="text-end" style="width:9%;">
                                        LB Art. 17<br/><small>bijz. bel.</small>
                                    </th>
                                    <th class="text-end" style="width:9%;">
                                        LB Art. 17a<br/><small>uitk. ineens</small>
                                    </th>
                                    <th class="text-end" style="width:8%;">
                                        LB Art. 17c<br/><small>overwerk</small>
                                    </th>
                                    <th class="text-end o_total o_border_bottom fw-bold"
                                        style="width:9%; color:#875A7B;">Totaal LB</th>
                                    <th class="text-end o_total o_border_bottom fw-bold"
                                        style="width:9%; color:#875A7B;">Premie AOV</th>
                                    <th class="text-end o_total o_border_bottom fw-bold"
                                        style="width:9%; color:#875A7B;">LB + AOV</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="rd['employees']" t-as="emp">
                                    <tr>
                                        <td class="fw-500">
                                            <t t-esc="emp['employee_name']"/>
                                        </td>
                                        <td class="text-muted">
                                            <t t-esc="emp['cribnr'] or '—'"/>
                                        </td>
                                        <td class="text-end">
                                            <t t-esc="'{:,.2f}'.format(emp['bruto'])"/>
                                        </td>
                                        <td class="text-end">
                                            <t t-esc="'{:,.2f}'.format(emp['lb_art14']) if emp['lb_art14'] else ''"/>
                                        </td>
                                        <td class="text-end">
                                            <t t-esc="'{:,.2f}'.format(emp['lb_bijz']) if emp['lb_bijz'] else ''"/>
                                        </td>
                                        <td class="text-end">
                                            <t t-esc="'{:,.2f}'.format(emp['lb_17a']) if emp['lb_17a'] else ''"/>
                                        </td>
                                        <td class="text-end">
                                            <t t-esc="'{:,.2f}'.format(emp['lb_overwerk']) if emp['lb_overwerk'] else ''"/>
                                        </td>
                                        <td class="text-end fw-bold" style="color:#875A7B;">
                                            <t t-esc="'{:,.2f}'.format(emp['lb_totaal'])"/>
                                        </td>
                                        <td class="text-end fw-bold" style="color:#875A7B;">
                                            <t t-esc="'{:,.2f}'.format(emp['aov_totaal'])"/>
                                        </td>
                                        <td class="text-end fw-bold" style="color:#875A7B;">
                                            <t t-esc="'{:,.2f}'.format(emp['lb_totaal'] + emp['aov_totaal'])"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                            <tfoot>
                                <tr class="o_total o_border_bottom fw-bold" style="color:#875A7B;">
                                    <td colspan="2">
                                        Totaal — <t t-esc="len(rd['employees'])"/> werknemers
                                    </td>
                                    <td class="text-end">
                                        <t t-esc="'{:,.2f}'.format(rd['totals']['bruto'])"/>
                                    </td>
                                    <td class="text-end">
                                        <t t-esc="'{:,.2f}'.format(rd['totals']['lb_art14'])"/>
                                    </td>
                                    <td class="text-end">
                                        <t t-esc="'{:,.2f}'.format(rd['totals']['lb_bijz'])"/>
                                    </td>
                                    <td class="text-end">
                                        <t t-esc="'{:,.2f}'.format(rd['totals']['lb_17a'])"/>
                                    </td>
                                    <td class="text-end">
                                        <t t-esc="'{:,.2f}'.format(rd['totals']['lb_overwerk'])"/>
                                    </td>
                                    <td class="text-end">
                                        <t t-esc="'{:,.2f}'.format(rd['totals']['lb_totaal'])"/>
                                    </td>
                                    <td class="text-end">
                                        <t t-esc="'{:,.2f}'.format(rd['totals']['aov_totaal'])"/>
                                    </td>
                                    <td class="text-end">
                                        <t t-esc="'{:,.2f}'.format(rd['totals']['lb_totaal'] + rd['totals']['aov_totaal'])"/>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>

                        <!-- ── Betalingssamenvatting ────────────────────────── -->
                        <table class="table table-sm table-borderless"
                               style="width:48%; margin-left:auto;">
                            <thead class="o_black_border">
                                <tr><th colspan="2">Betalingssamenvatting</th></tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>In te houden Loonbelasting</td>
                                    <td class="text-end fw-bold" style="color:#875A7B;">
                                        SRD&#160;<t t-esc="'{:,.2f}'.format(rd['totals']['lb_totaal'])"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td>In te houden Premie AOV</td>
                                    <td class="text-end fw-bold" style="color:#875A7B;">
                                        SRD&#160;<t t-esc="'{:,.2f}'.format(rd['totals']['aov_totaal'])"/>
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot>
                                <tr class="o_total o_border_bottom fw-bold" style="color:#875A7B;">
                                    <td>Totaal te betalen</td>
                                    <td class="text-end" style="font-size:11pt;">
                                        SRD&#160;<t t-esc="'{:,.2f}'.format(rd['totals']['lb_totaal'] + rd['totals']['aov_totaal'])"/>
                                    </td>
                                </tr>
                            </tfoot>
                        </table>

                        <!-- ── Ondertekeningsblok ───────────────────────────── -->
                        <div style="margin-top:20px; font-size:8.5pt;" class="text-muted">
                            <p>
                                Aldus opgemaakt te Paramaribo, op datum: ___________________________
                            </p>
                            <p>
                                Te betalen uiterlijk
                                <strong style="color:#875A7B;">
                                    <t t-esc="rd['betaaldatum']"/>
                                </strong>
                                via portaal.belastingdienst.sr of aan de kassa van de Belastingdienst.
                            </p>
                        </div>
                        <table style="width:72%; margin-top:16px; font-size:8.5pt;">
                            <tr>
                                <td style="width:44%; border-top:1px solid #555; padding-top:5px; text-align:center;">
                                    Directeur / Manager
                                </td>
                                <td style="width:12%;"/>
                                <td style="width:44%; border-top:1px solid #555; padding-top:5px; text-align:center;">
                                    Hoofd Salarisadministratie
                                </td>
                            </tr>
                        </table>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
