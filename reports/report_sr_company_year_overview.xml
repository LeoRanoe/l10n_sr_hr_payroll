<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════════════
         SR Bedrijfs Jaaroverzicht — Jaar PDF
         Model: sr.payroll.company.year.wizard
         ═══════════════════════════════════════════════════════════════ -->

    <!-- Report action -->
    <record id="action_report_sr_company_year_overview" model="ir.actions.report">
        <field name="name">Bedrijfs Jaaroverzicht Loonbelasting</field>
        <field name="model">sr.payroll.company.year.wizard</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">l10n_sr_hr_payroll.report_sr_company_year_overview</field>
        <field name="report_file">l10n_sr_hr_payroll.report_sr_company_year_overview</field>
        <field name="paperformat_id" ref="l10n_sr_hr_payroll.paperformat_sr_landscape"/>
    </record>

    <!-- ── QWeb Template ──────────────────────────────────────────── -->
    <template id="report_sr_company_year_overview">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="rd" t-value="o._get_company_year_overview_data()"/>
                <t t-call="web.external_layout">
                    <div class="page">

                        <!-- ── Koptitel ─────────────────────────────────────── -->
                        <h2 style="margin-bottom:2px;">BEDRIJFS JAAROVERZICHT LOONBELASTING</h2>
                        <p class="text-muted" style="font-size:9pt; margin-top:0; margin-bottom:8px;">
                            Overzicht ingehouden loonbelasting en premies per werknemer
                        </p>

                        <!-- ── Overzicht-info ────────────────────────────────── -->
                        <table class="table table-sm table-borderless" style="width:60%;">
                            <tbody>
                                <tr>
                                    <td class="fw-bold" style="width:30%;">Boekjaar</td>
                                    <td t-esc="rd['year']"/>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Werknemers</td>
                                    <td t-esc="rd['employee_count']"/>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Loonstroken</td>
                                    <td t-esc="rd['slip_count']"/>
                                </tr>
                                <tr>
                                    <td class="fw-bold">Gegenereerd op</td>
                                    <td t-esc="str(rd['generated_on'])"/>
                                </tr>
                            </tbody>
                        </table>

                        <!-- ── Afdeling-tabellen ──────────────────────────── -->
                        <t t-foreach="rd['dept_groups']" t-as="dept">
                            <table class="table table-sm" style="font-size:7pt; margin-bottom:10px;">
                                <thead class="o_black_border">
                                    <tr>
                                        <td colspan="13" class="fw-bold">
                                            Afdeling: <t t-esc="dept['dept_name']"/>
                                            &#160;·&#160;<t t-esc="len(dept['employees'])"/> werknemers
                                        </td>
                                    </tr>
                                    <tr>
                                        <th style="width:19%;">Werknemer</th>
                                        <th class="text-end" style="width:5%;">Per.</th>
                                        <th class="text-end" style="width:8%;">Bruto (SRD)</th>
                                        <th class="text-end" style="width:7%;">
                                            Bijz. bel.<br/><small>bruto</small>
                                        </th>
                                        <th class="text-end" style="width:7%;">
                                            LB Art.14<br/><small>regulier</small>
                                        </th>
                                        <th class="text-end" style="width:7%;">
                                            LB Art.17<br/><small>bijz.</small>
                                        </th>
                                        <th class="text-end" style="width:6%;">
                                            LB Art.17a<br/><small>uitk.</small>
                                        </th>
                                        <th class="text-end" style="width:6%;">
                                            LB Art.17c<br/><small>overwerk</small>
                                        </th>
                                        <th class="text-end o_total o_border_bottom"
                                            style="width:7%; color:#875A7B;">Totaal LB</th>
                                        <th class="text-end" style="width:6%;">AOV</th>
                                        <th class="text-end" style="width:6%;">Heff.k.</th>
                                        <th class="text-end" style="width:6%;">Pensioen</th>
                                        <th class="text-end o_total o_border_bottom"
                                            style="width:6%; color:#875A7B;">Netto (SRD)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <t t-foreach="dept['employees']" t-as="emp">
                                        <tr>
                                            <td>
                                                <t t-esc="emp.get('employee_name', '—')"/>
                                                <small class="text-muted d-block">
                                                    <t t-esc="emp.get('slip_count', 0)"/> periodes
                                                </small>
                                            </td>
                                            <td class="text-end text-muted" t-esc="emp.get('slip_count', 0)"/>
                                            <td class="text-end" t-esc="'{:,.2f}'.format(emp.get('amount_bruto_srd', 0.0))"/>
                                            <td class="text-end" t-esc="'{:,.2f}'.format(emp.get('amount_bijz_bruto_srd', 0.0)) if emp.get('amount_bijz_bruto_srd') else ''"/>
                                            <td class="text-end" t-esc="'{:,.2f}'.format(emp.get('amount_lb_art14_srd', 0.0)) if emp.get('amount_lb_art14_srd') else ''"/>
                                            <td class="text-end" t-esc="'{:,.2f}'.format(emp.get('amount_lb_bijz_srd', 0.0)) if emp.get('amount_lb_bijz_srd') else ''"/>
                                            <td class="text-end" t-esc="'{:,.2f}'.format(emp.get('amount_lb_17a_srd', 0.0)) if emp.get('amount_lb_17a_srd') else ''"/>
                                            <td class="text-end" t-esc="'{:,.2f}'.format(emp.get('amount_lb_overwerk_srd', 0.0)) if emp.get('amount_lb_overwerk_srd') else ''"/>
                                            <td class="text-end fw-bold" style="color:#875A7B;"
                                                t-esc="'{:,.2f}'.format(emp.get('amount_lb_srd', 0.0))"/>
                                            <td class="text-end" t-esc="'{:,.2f}'.format(emp.get('amount_aov_srd', 0.0)) if emp.get('amount_aov_srd') else ''"/>
                                            <td class="text-end" t-esc="'{:,.2f}'.format(emp.get('amount_heffingskorting_srd', 0.0)) if emp.get('amount_heffingskorting_srd') else ''"/>
                                            <td class="text-end" t-esc="'{:,.2f}'.format(emp.get('amount_pensioen_srd', 0.0)) if emp.get('amount_pensioen_srd') else ''"/>
                                            <td class="text-end fw-bold" style="color:#875A7B;"
                                                t-esc="'{:,.2f}'.format(emp.get('amount_netto_srd', 0.0))"/>
                                        </tr>
                                    </t>
                                </tbody>
                                <tfoot>
                                    <tr class="o_total o_border_bottom fw-bold" style="color:#875A7B;">
                                        <td colspan="2">Subtotaal <t t-esc="dept['dept_name']"/></td>
                                        <td class="text-end" t-esc="'{:,.2f}'.format(dept['totals'].get('amount_bruto_srd', 0.0))"/>
                                        <td class="text-end" t-esc="'{:,.2f}'.format(dept['totals'].get('amount_bijz_bruto_srd', 0.0))"/>
                                        <td class="text-end" t-esc="'{:,.2f}'.format(dept['totals'].get('amount_lb_art14_srd', 0.0))"/>
                                        <td class="text-end" t-esc="'{:,.2f}'.format(dept['totals'].get('amount_lb_bijz_srd', 0.0))"/>
                                        <td class="text-end" t-esc="'{:,.2f}'.format(dept['totals'].get('amount_lb_17a_srd', 0.0))"/>
                                        <td class="text-end" t-esc="'{:,.2f}'.format(dept['totals'].get('amount_lb_overwerk_srd', 0.0))"/>
                                        <td class="text-end" t-esc="'{:,.2f}'.format(dept['totals'].get('amount_lb_srd', 0.0))"/>
                                        <td class="text-end" t-esc="'{:,.2f}'.format(dept['totals'].get('amount_aov_srd', 0.0))"/>
                                        <td class="text-end" t-esc="'{:,.2f}'.format(dept['totals'].get('amount_heffingskorting_srd', 0.0))"/>
                                        <td class="text-end" t-esc="'{:,.2f}'.format(dept['totals'].get('amount_pensioen_srd', 0.0))"/>
                                        <td class="text-end" t-esc="'{:,.2f}'.format(dept['totals'].get('amount_netto_srd', 0.0))"/>
                                    </tr>
                                </tfoot>
                            </table>
                        </t>

                        <!-- ── Totaal Bedrijf ──────────────────────────────── -->
                        <table class="table table-sm" style="font-size:8pt;">
                            <tfoot>
                                <tr class="o_total o_border_bottom fw-bold" style="color:#875A7B; font-size:8.5pt;">
                                    <td colspan="2" style="width:24%;">
                                        Totaal Bedrijf <t t-esc="rd['year']"/>
                                        (<t t-esc="rd['employee_count']"/> werknemers)
                                    </td>
                                    <td class="text-end" style="width:8%;" t-esc="'{:,.2f}'.format(rd['grand_totals'].get('amount_bruto_srd', 0.0))"/>
                                    <td class="text-end" style="width:7%;" t-esc="'{:,.2f}'.format(rd['grand_totals'].get('amount_bijz_bruto_srd', 0.0))"/>
                                    <td class="text-end" style="width:7%;" t-esc="'{:,.2f}'.format(rd['grand_totals'].get('amount_lb_art14_srd', 0.0))"/>
                                    <td class="text-end" style="width:7%;" t-esc="'{:,.2f}'.format(rd['grand_totals'].get('amount_lb_bijz_srd', 0.0))"/>
                                    <td class="text-end" style="width:6%;" t-esc="'{:,.2f}'.format(rd['grand_totals'].get('amount_lb_17a_srd', 0.0))"/>
                                    <td class="text-end" style="width:6%;" t-esc="'{:,.2f}'.format(rd['grand_totals'].get('amount_lb_overwerk_srd', 0.0))"/>
                                    <td class="text-end" style="width:7%;" t-esc="'{:,.2f}'.format(rd['grand_totals'].get('amount_lb_srd', 0.0))"/>
                                    <td class="text-end" style="width:6%;" t-esc="'{:,.2f}'.format(rd['grand_totals'].get('amount_aov_srd', 0.0))"/>
                                    <td class="text-end" style="width:6%;" t-esc="'{:,.2f}'.format(rd['grand_totals'].get('amount_heffingskorting_srd', 0.0))"/>
                                    <td class="text-end" style="width:6%;" t-esc="'{:,.2f}'.format(rd['grand_totals'].get('amount_pensioen_srd', 0.0))"/>
                                    <td class="text-end" style="width:6%;" t-esc="'{:,.2f}'.format(rd['grand_totals'].get('amount_netto_srd', 0.0))"/>
                                </tr>
                            </tfoot>
                        </table>

                        <!-- ── Fiscale toelichting ────────────────────────── -->
                        <p class="text-muted" style="font-size:7.5pt; margin-top:6px;">
                            <strong>Uitleg fiscale kolommen:</strong>
                            Art.&#160;14&#160;= regulier loon;
                            Art.&#160;17&#160;= bijzondere beloningen (bonus, vakantiegeld);
                            Art.&#160;17a&#160;= uitkering ineens of jubileum;
                            Art.&#160;17c&#160;= overwerk;
                            AOV&#160;= premie Algemene Ouderdomsvoorziening;
                            Heff.k.&#160;= heffingskorting.
                        </p>

                        <!-- ── Ondertekeningsblok ─────────────────────────── -->
                        <p class="text-muted" style="margin-top:20px; font-size:8pt;">
                            Aldus opgemaakt te Paramaribo, op datum: ___________________________
                        </p>
                        <table style="width:64%; margin-top:16px; font-size:8.5pt;">
                            <tr>
                                <td style="width:46%; border-top:1px solid #555; padding-top:5px; text-align:center;">
                                    Directeur / Manager
                                </td>
                                <td style="width:8%;"/>
                                <td style="width:46%; border-top:1px solid #555; padding-top:5px; text-align:center;">
                                    Hoofd Administratie
                                </td>
                            </tr>
                        </table>

                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
