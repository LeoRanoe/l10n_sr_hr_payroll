<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Suriname Payroll — Contract Formulier Uitbreiding
        Voegt het tabblad "Suriname Loon" toe aan het contract formulier.

        Deze basisloonvariant beperkt contractinvoer tot:
        - contractvaluta
        - basisloon
        - verloningstype
        - live rekenvoorbeeld
    -->
    <record id="hr_contract_sr_view_form" model="ir.ui.view">
        <field name="name">hr.contract.sr.form</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Suriname Payroll" name="sr_payroll_tab">

                    <div class="alert alert-info d-flex align-items-center mb-3" role="alert">
                        <div>
                            <strong><i class="fa fa-info-circle"/> Artikel 14 WLB — Actief</strong>
                            <span class="text-muted ms-2">
                                Deze basisloonvariant gebruikt alleen contractvaluta, basisloon en verloningstype.
                            </span>
                        </div>
                    </div>

                    <notebook>
                        <page string="Fiscale Data" name="sr_fiscale_data_tab">
                            <group string="Basisloon &amp; Verloning" name="sr_basis_verloning">
                                <group>
                                    <field name="sr_contract_currency"
                                           options="{'no_create': True, 'no_open': True}"
                                           domain="[('name', 'in', ['SRD', 'USD', 'EUR'])]"
                                           string="Contractvaluta"
                                           help="Basisloonvaluta. Bij vreemde valuta: zie koers onder 'Wisselkoers (bedrijfsinstelling)'. Alle bedragen worden naar SRD omgerekend."/>
                                    <field name="wage" widget="monetary" options="{'currency_field': 'sr_contract_currency'}" required="1"
                                           string="Basisloon (per maand)"
                                           help="Voer het maandloon in. Voor FN-contracten berekent het systeem automatisch het bedrag per fortnight (× 12 ÷ 26)."/>
                                    <field name="sr_salary_type"
                                           widget="radio"
                                           string="Belastingtype"
                                           required="1"
                                           help="Maandloon: 12 periodes. FN: 26 periodes — basisloon wordt automatisch omgerekend (maandloon × 12 ÷ 26) per fortnight."/>
                                    <field name="sr_wage_per_period_srd"
                                           readonly="1"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           invisible="sr_salary_type != 'fn'"
                                           string="Loon per Fortnight (SRD)"
                                           help="Automatisch berekend: maandloon × 12 ÷ 26. Dit bedrag wordt als BASIC op de loonstrook gebruikt."/>
                                    <field name="sr_hourly_wage" readonly="1"
                                           help="Bruto uurloon (automatisch berekend): maandloon ÷ 173,33."/>
                                    <!-- Valutapaar: wisselkoers + SRD equivalent — alleen zichtbaar voor vreemde valuta -->
                                    <field name="sr_current_exchange_rate_display"
                                           readonly="1"
                                           digits="[16, 6]"
                                           invisible="not sr_contract_currency or sr_contract_currency.name == 'SRD'"
                                           string="Wisselkoers (bedrijfsinstelling)"/>
                                    <field name="sr_wage_srd"
                                           readonly="1"
                                           widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           invisible="not sr_contract_currency or sr_contract_currency.name == 'SRD'"
                                           string="Basisloon in SRD (maand)"/>
                                </group>
                                <group>
                                    <div class="alert alert-danger border mb-0" role="alert" invisible="wage &gt; 0">
                                        Een actief SR payroll-contract vereist een positief basisloon. Zonder loon worden uurloon, overwerk en LB/AOV geblokkeerd.
                                    </div>
                                </group>
                            </group>

                            <div class="alert alert-light border mb-0" role="status">
                                Deze contractweergave is afgebakend tot <strong>basisloon</strong>.
                                Kinderbijslag, overwerk, toelagen en overige inhoudingen worden hier niet meer ingevoerd.
                            </div>
                        </page>

                        <page string="Controle &amp; Voorbeeld" name="sr_controle_preview_tab">
                            <separator string="Geschatte Loonstrook per Periode"/>
                            <div class="alert alert-info small mb-3" role="status">
                                <i class="fa fa-info-circle"/>&#160;Schatting op basis van alleen basisloon. Toelagen, overwerk en andere extra componenten vallen buiten deze basisloonvariant.
                            </div>
                            <div class="alert alert-warning small mb-3" role="status" invisible="sr_salary_type != 'fn'">
                                <i class="fa fa-balance-scale"/>&#160;Deze FN-preview toont een normale periode. Alleen op FN26 kan een kleine jaarafronding verschijnen zodat 26 FN-loonstroken exact aansluiten op 12 maandperiodes.
                            </div>
                            <group>
                                <group string="Bruto &amp; Belastbaar">
                                    <field name="sr_preview_bruto" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}" string="Bruto Loon"/>
                                    <field name="sr_preview_belastinggrondslag" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}" string="Grondslag voor Belasting"/>
                                    <field name="sr_preview_belastbaar_jaar" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}" string="Belastbaar Jaarloon (Art. 14)"/>
                                </group>
                                <group string="Inhoudingen &amp; Netto">
                                    <field name="sr_preview_lb_periode" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}" string="Loonbelasting (Art. 14)"/>
                                    <field name="sr_preview_aov_periode" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}" string="AOV Inhouding (4%)"/>
                                    <field name="sr_preview_netto" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}" string="Geschat Nettoloon"/>
                                    <field name="sr_preview_netto_jaar" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}" string="Verwacht Netto per Jaar"/>
                                    <field name="sr_preview_fn26_correctie" readonly="1" widget="monetary" options="{'currency_field': 'currency_id'}" string="Verwachte FN26 Jaarafronding" invisible="sr_salary_type != 'fn'"/>
                                </group>
                            </group>
                            <separator string="Artikel 14 Tariefschijven"/>
                            <field name="sr_tax_bracket_html" nolabel="1" readonly="1"/>
                            <separator string="Berekeningsdetail — Stap-voor-Stap"/>
                            <field name="sr_preview_breakdown_html" nolabel="1" readonly="1"/>
                        </page>
                    </notebook>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
