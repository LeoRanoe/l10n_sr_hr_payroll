<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_payslip_run_form_sr_tax_overview" model="ir.ui.view">
        <field name="name">hr.payslip.run.form.sr.tax.overview</field>
        <field name="model">hr.payslip.run</field>
        <field name="active">True</field>
        <field name="inherit_id" ref="hr_payroll.hr_payslip_run_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="sr_has_sr_payslips" invisible="1"/>
                <button
                    name="action_print_sr_tax_overview"
                    string="Fiscaal overzicht (PDF)"
                    type="object"
                    class="btn-secondary"
                    icon="fa-file-pdf"
                    invisible="state not in ('close', 'paid') or not sr_has_sr_payslips"
                    help="Exporteer per loonrun een belastingoverzicht in PDF voor alle afgeronde SR-loonstroken."/>
                <button
                    name="action_print_sr_company_period_overview"
                    string="Periodeoverzicht (PDF)"
                    type="object"
                    class="btn-secondary"
                    icon="fa-building"
                    invisible="state not in ('close', 'paid') or not sr_has_sr_payslips"
                    help="Exporteer het totale bedrijfsbelastingoverzicht van deze loonperiode als PDF, gegroepeerd per afdeling."/>
                <button
                    name="action_print_sr_maandaangifte"
                    string="Maandaangifte LB + AOV"
                    type="object"
                    class="btn-primary"
                    icon="fa-landmark"
                    invisible="state not in ('close', 'paid') or not sr_has_sr_payslips"
                    help="Genereer de aangifte Loonbelasting en Premie AOV voor indiening bij de Belastingdienst Suriname (PDF)."/>
                <button
                    name="action_open_sr_verzamelloonstaat_wizard"
                    string="Verzamelloonstaat (CSV)"
                    type="object"
                    class="btn-secondary"
                    icon="fa-file-export"
                    invisible="state not in ('close', 'paid') or not sr_has_sr_payslips"
                    help="Exporteer de jaarlijkse Verzamelloonstaat CSV voor de Belastingdienst Suriname."/>
            </xpath>
            <xpath expr="//sheet/group" position="after">
                <group string="SR Rapporten">
                    <div class="alert alert-warning" role="alert" colspan="2"
                         invisible="sr_has_sr_payslips">
                        Deze batch bevat nog geen SR-loonstroken. Koppel eerst SR-loonstroken aan deze batch of genereer de loonstroken vanuit de batch.
                    </div>
                    <div class="alert alert-info" role="alert" colspan="2"
                         invisible="not sr_has_sr_payslips or state in ('close', 'paid')">
                        De SR-rapporten komen beschikbaar nadat de batch is gevalideerd/afgesloten.
                    </div>
                    <div class="o_row" colspan="2" invisible="state not in ('close', 'paid') or not sr_has_sr_payslips">
                        <button
                            name="action_print_sr_tax_overview"
                            string="Fiscaal overzicht (PDF)"
                            type="object"
                            class="btn-secondary"
                            icon="fa-file-pdf"/>
                        <button
                            name="action_print_sr_company_period_overview"
                            string="Periodeoverzicht (PDF)"
                            type="object"
                            class="btn-secondary"
                            icon="fa-building"/>
                        <button
                            name="action_print_sr_maandaangifte"
                            string="Maandaangifte LB + AOV"
                            type="object"
                            class="btn-primary"
                            icon="fa-landmark"/>
                        <button
                            name="action_open_sr_verzamelloonstaat_wizard"
                            string="Verzamelloonstaat (CSV)"
                            type="object"
                            class="btn-secondary"
                            icon="fa-file-export"/>
                    </div>
                </group>
            </xpath>
        </field>
    </record>

</odoo>
