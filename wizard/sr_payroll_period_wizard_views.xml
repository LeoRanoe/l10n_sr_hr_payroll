<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sr_period_wizard_form" model="ir.ui.view">
        <field name="name">sr.payroll.period.wizard.form</field>
        <field name="model">sr.payroll.period.wizard</field>
        <field name="arch" type="xml">
            <form string="Maandaangifte &amp; Periodeoverzicht">
                <div class="alert alert-info" role="alert" style="margin-bottom:12px;">
                    Selecteer een gesloten loonrun om de periode-rapporten te genereren.<br/>
                    De <strong>Maandaangifte LB+AOV</strong> dient uiterlijk de
                    <strong>10e van de volgende maand</strong> ingediend te worden
                    bij de Belastingdienst Suriname.
                </div>
                <group>
                    <group string="Selectie">
                        <field name="company_id"/>
                        <field name="payslip_run_id"/>
                    </group>
                    <group string="Geselecteerde Periode" invisible="not payslip_run_id">
                        <field name="run_name" string="Loonrun naam"/>
                        <field name="date_from"/>
                        <field name="date_to"/>
                    </group>
                </group>
                <footer>
                    <button string="Maandaangifte LB+AOV (PDF)"
                            name="action_print_maandaangifte"
                            type="object"
                            class="btn-primary"
                            icon="fa-landmark"
                            invisible="not payslip_run_id"/>
                        <button string="Bedrijfs periodeoverzicht (PDF)"
                            name="action_print_periode_overzicht"
                            type="object"
                            class="btn-secondary"
                            icon="fa-building"
                            invisible="not payslip_run_id"/>
                    <button string="Sluiten" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sr_periode_wizard" model="ir.actions.act_window">
        <field name="name">Maandaangifte &amp; Periodeoverzicht</field>
        <field name="res_model">sr.payroll.period.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
